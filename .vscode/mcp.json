{
  "servers": {
    "codegraph": {
      "type": "stdio",
      "command": "C:\\Users\\minhi\\.codegraph\\bin\\codegraph-server.exe",
      "args": [
        "--mcp",
        "--workspace",
        "D:\\ListPorject\\TransReaderV1.0"
      ]
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
